{
  "name": "darc-services",
  "main": "workerd/worker.ts",
  "compatibility_date": "2025-05-07",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "durable_objects": {
    "bindings": [{ "name": "MCP_CONNECTIONS", "class_name": "McpConnection" }]
